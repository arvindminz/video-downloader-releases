<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme -->
    <style name="Theme.VideoDownloader" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Add your existing theme items here (colors, typography, etc.) -->
    </style>

    <!--
        SharePopup theme — makes SharePopupActivity appear as a floating
        dialog with a dimmed background over the source app.
    -->
    <style name="Theme.VideoDownloader.SharePopup" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>